MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brutal_portfolio

# Google Gemini API key - powers the Manifesto Engine (app/api/ai/manifesto).
# Leave blank to disable; the section will show a graceful error instead.
GEMINI_API_KEY=

# Optional, reserved for contact-form email notifications.
EMAIL_USER=
EMAIL_PASS=

# Cloudinary - required for admin image uploads (/api/upload).
# Uploads are filed under brutal-portfolio/<module>/ in your media library.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password for the /admin panel. Checked server-side in app/api/admin/login,
# so it is never shipped to the browser. Required - there is no default.
ADMIN_PASSWORD=
